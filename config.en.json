{
  "title": "PC Deck",
  "port": 8765,
  "columns": 3,
  "columnsLandscape": 5,
  "pages": [
    {
      "name": "Media",
      "icon": "music_note",
      "buttons": [
        {
          "label": "Previous",
          "icon": "skip_previous",
          "color": "#7c5cff",
          "actions": [
            {
              "type": "media",
              "key": "prev"
            }
          ]
        },
        {
          "label": "Play / Pause",
          "icon": "play_pause",
          "color": "#1ed760",
          "actions": [
            {
              "type": "media",
              "key": "play_pause"
            }
          ]
        },
        {
          "label": "Next",
          "icon": "skip_next",
          "color": "#7c5cff",
          "actions": [
            {
              "type": "media",
              "key": "next"
            }
          ]
        },
        {
          "label": "Volume -",
          "icon": "volume_down",
          "color": "#38bdf8",
          "actions": [
            {
              "type": "volume",
              "step": -5
            }
          ]
        },
        {
          "label": "Mute",
          "icon": "volume_off",
          "color": "#f43f5e",
          "actions": [
            {
              "type": "volume",
              "mute": "toggle"
            }
          ]
        },
        {
          "label": "Volume +",
          "icon": "volume_up",
          "color": "#38bdf8",
          "actions": [
            {
              "type": "volume",
              "step": 5
            }
          ]
        },
        {
          "label": "Spotify",
          "icon": "library_music",
          "color": "#1ed760",
          "actions": [
            {
              "type": "open",
              "target": "spotify:"
            }
          ]
        },
        {
          "label": "YouTube",
          "icon": "smart_display",
          "color": "#ff3d3d",
