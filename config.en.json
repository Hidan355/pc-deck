            }
          ]
        }
      ]
    },
    {
      "name": "Macros",
      "icon": "bolt",
      "buttons": [
        {
          "label": "Work mode",
          "icon": "rocket_launch",
          "color": "#7c5cff",
          "actions": [
            {
              "type": "volume",
              "set": 20
            },
            {
              "type": "open",
              "target": "https://mail.google.com"
            },
            {
              "type": "wait",
              "ms": 400
            },
            {
              "type": "open",
              "target": "https://calendar.google.com"
            },
            {
              "type": "page",
              "to": "Shortcuts"
            }
          ]
        },
        {
          "label": "Signature",
          "icon": "signature",
          "color": "#38bdf8",
          "actions": [
            {
              "type": "text",
              "text": "\nBest regards,\nYour Name"
            }
          ]
        },
        {
          "label": "Coffee break",
          "icon": "coffee",
          "color": "#f97316",
          "actions": [
            {
              "type": "media",
              "key": "play_pause"
            },
            {
              "type": "keys",
              "keys": "win+d"
            },
            {
              "type": "run",
              "cmd": "rundll32.exe user32.dll,LockWorkStation"
            }
          ]
        },
        {
          "label": "Shut down in 1h",
          "icon": "bedtime",
          "color": "#a78bfa",
          "confirm": true,
          "actions": [
            {
              "type": "run",
              "cmd": "shutdown /s /t 3600"
            }
          ]
        },
        {
          "label": "Cancel shutdown",
          "icon": "cancel",
          "color": "#1ed760",
          "actions": [
            {
              "type": "run",
              "cmd": "shutdown /a"
            }
          ]
        },
        {
          "label": "Restart",
          "icon": "restart_alt",
          "color": "#f97316",
          "confirm": true,
          "actions": [
            {
              "type": "run",
              "cmd": "shutdown /r /t 5"
            }
          ]
        },
        {
          "label": "Shut down",
          "icon": "power_settings_new",
          "color": "#f43f5e",
          "confirm": true,
          "actions": [
            {
              "type": "run",
              "cmd": "shutdown /s /t 5"
            }
          ]
        }
      ]
    }
