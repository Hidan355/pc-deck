            {
              "type": "open",
              "target": "https://www.youtube.com"
            }
          ]
        },
        {
          "label": "Volume 30%",
          "icon": "graphic_eq",
          "color": "#a78bfa",
          "actions": [
            {
              "type": "volume",
              "set": 30
            }
          ]
        }
      ]
    },
    {
      "name": "Apps",
      "icon": "apps",
